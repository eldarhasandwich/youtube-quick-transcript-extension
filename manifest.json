{
  "manifest_version": 3,
  "name": "YouTube Transcript Copier",
  "version": "3.3.1",
  "description": "Pull and copy YouTube transcripts from a button beside Like.",
  "permissions": ["storage", "clipboardWrite", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "Transcript Copier settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["format.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
